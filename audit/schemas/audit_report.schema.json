{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["session", "features", "metadata"],
  "properties": {
    "session": {"type": "string"},
    "metadata": {
      "type": "object",
      "required": ["timestamp"],
      "properties": {
        "timestamp": {"type": "string"},
        "commit": {"type": ["string", "null"]}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "availability", "smoke"],
        "properties": {
          "name": {"type": "string"},
          "availability": {
            "type": "object",
            "required": ["status", "details"],
            "properties": {
              "status": {"type": "string"},
              "details": {"type": "string"}
            }
          },
          "smoke": {
            "type": "object",
            "required": ["status", "details"],
            "properties": {
              "status": {"type": "string"},
              "details": {"type": "string"}
            }
          },
          "readiness": {
            "type": "object",
            "required": ["level", "label"],
            "properties": {
              "level": {"type": "integer"},
              "label": {"type": "string"}
            }
          },
          "issues": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
