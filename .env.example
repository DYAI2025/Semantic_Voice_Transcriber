# ============================================================================
# Semantic Voice Transcriber - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual tokens/keys
# IMPORTANT: Never commit .env to git! It's already in .gitignore
#
# Setup Instructions:
#   1. cp .env.example .env
#   2. Edit .env with your actual tokens
#   3. See INSTALLATION.md for detailed setup guide
# ============================================================================

# ----------------------------------------------------------------------------
# Hugging Face Token (REQUIRED for Speaker Diarization)
# ----------------------------------------------------------------------------
# 1. Create account: https://huggingface.co/join
# 2. Accept model agreements:
#    - https://huggingface.co/pyannote/segmentation-3.0
#    - https://huggingface.co/pyannote/speaker-diarization-3.1
# 3. Create token: https://huggingface.co/settings/tokens (Type: Read)
# 4. Copy token below (starts with hf_...)
# ----------------------------------------------------------------------------
HF_TOKEN=hf_YourHuggingFaceTokenHere


# ----------------------------------------------------------------------------
# OpenAI API Configuration (OPTIONAL - for GPT-4 Psychoanalysis Dashboard)
# ----------------------------------------------------------------------------
# Primary API key (required if using OpenAI)
# Get from: https://platform.openai.com/api-keys
# ----------------------------------------------------------------------------
OPENAI_API_KEY_PRIMARY=sk-YourPrimaryKeyHere

# Fallback API key (optional - for redundancy)
OPENAI_API_KEY_FALLBACK=sk-YourFallbackKeyHere

# Model configuration
OPENAI_DASHBOARD_MODEL_PRIMARY=gpt-4-turbo-preview
OPENAI_DASHBOARD_MODEL_FALLBACK=gpt-4o-mini

# Active profile selection
OPENAI_API_PROFILE=primary
OPENAI_API_KEY_ALIAS=primary


# ----------------------------------------------------------------------------
# Dashboard Retry Configuration (Advanced)
# ----------------------------------------------------------------------------
# Controls retry behavior for API failures
DASHBOARD_MAX_RETRIES=4
DASHBOARD_RETRY_BASE_DELAY=2.0
DASHBOARD_RETRY_MAX_DELAY=30.0
DASHBOARD_RETRY_JITTER=1.0


# ----------------------------------------------------------------------------
# Ollama Configuration (OPTIONAL - FREE local LLM alternative)
# ----------------------------------------------------------------------------
# To use local Ollama instead of OpenAI:
# 1. Install: curl -fsSL https://ollama.com/install.sh | sh
# 2. Start: ollama serve
# 3. Download model: ollama pull qwen2.5-coder:7b
# 4. Set provider in config/psychoanalysis_config.yaml: provider: ollama
#
# Uncomment if using non-default endpoint:
# ----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434


# ----------------------------------------------------------------------------
# Advanced Configuration (OPTIONAL)
# ----------------------------------------------------------------------------
# Uncomment and modify if needed:

# Default Whisper model size (tiny/base/small/medium/large)
# DEFAULT_WHISPER_MODEL=small

# Enable debug logging
# DEBUG=true

# Custom directories
# OUTPUT_DIR=./Transkripte_LLM
# MEMORY_DIR=./Memory


# ============================================================================
# Verification
# ============================================================================
# After setup, verify with:
#   python3 -c "from dotenv import load_dotenv; import os; load_dotenv(); \
#               print('✅ HF_TOKEN:', 'OK' if os.getenv('HF_TOKEN') else 'MISSING')"
# ============================================================================
