# Hugging Face Token für Speaker Diarization
# Erstelle Token auf: https://huggingface.co/settings/tokens
# Akzeptiere zuerst die User Agreements:
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=dein_token_hier

# OpenAI Dashboard Profiles
# Define profile-specific keys/models for FR-4.
OPENAI_API_PROFILE=primary
OPENAI_API_KEY_PRIMARY=sk-primary
OPENAI_API_KEY_FALLBACK=sk-fallback
OPENAI_DASHBOARD_MODEL_PRIMARY=gpt-4-turbo-preview
OPENAI_DASHBOARD_MODEL_FALLBACK=gpt-4o-mini
OPENAI_API_KEY_ALIAS=primary

# Dashboard retry configuration
DASHBOARD_MAX_RETRIES=4
DASHBOARD_RETRY_BASE_DELAY=2.0
DASHBOARD_RETRY_MAX_DELAY=30.0
DASHBOARD_RETRY_JITTER=1.0
